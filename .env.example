# Copy this file to .env and replace YOUR_MODEL_ID with the LM Studio model ID.
LLM_MODEL=openai/YOUR_MODEL_ID

# For Docker; outside Docker, use http://localhost:1234/v1 instead.
OPENAI_API_BASE=http://host.docker.internal:1234/v1

# Placeholder when LM Studio authentication is disabled.
# If authentication is enabled, use your LM Studio API token in .env.
OPENAI_API_KEY=lm-studio
